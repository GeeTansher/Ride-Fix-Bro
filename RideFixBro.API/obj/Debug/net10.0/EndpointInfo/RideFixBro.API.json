        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatRequest": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "imageData": {
            "type": [
