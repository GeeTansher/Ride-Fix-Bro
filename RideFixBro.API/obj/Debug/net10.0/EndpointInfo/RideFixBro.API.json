{
  "openapi": "3.1.1",
  "info": {
    "title": "RideFixBro.API | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://0.0.0.0:5000"
    }
  ],
  "paths": {
    "/api/Chat/upload-dummy-manual": {
      "post": {
        "tags": [
          "Chat"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Chat/upload-pdf-manual": {
      "post": {
        "tags": [
          "Chat"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Chat/ask": {
      "post": {
        "tags": [
          "Chat"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            },
            "application/*+json": {
