# Visual Studio user state and .NET build output
.vs/
[Bb]in/
[Oo]bj/
*.user
*.suo
*.rsuser
*.userosscache
*.sln.docstates

# Local deployment profiles can contain account details or credentials.
*.pubxml
*.publishsettings

# Test results and coverage output
[Tt]est[Rr]esults/
coverage/
*.trx
*.coverage
*.coveragexml

# Gradle and Android generated files; keep gradle/wrapper and its JAR.
.gradle/
.kotlin/
build/
local.properties
.externalNativeBuild/
.cxx/
captures/
*.iml
*.apk
*.aab
*.ap_
*.dex
*.hprof

# Keep shared .idea code styles, inspections, and project settings.
# Ignore per-user state and files regenerated by Gradle import.
**/.idea/caches/
**/.idea/libraries/
**/.idea/shelf/
**/.idea/workspace.xml
**/.idea/tasks.xml
**/.idea/usage.statistics.xml
**/.idea/modules.xml
**/.idea/gradle.xml
**/.idea/compiler.xml
**/.idea/jarRepositories.xml
**/.idea/navEditor.xml
**/.idea/assetWizardSettings.xml
**/.idea/deploymentTargetSelector.xml
**/.idea/deploymentTargetDropDown.xml
**/.idea/deviceManager.xml

# Local secrets and signing keys; keep sanitized example env files.
# Checked-in appsettings.json and appsettings.Development.json must stay secret-free.
.env
.env.*
!.env.example
!.env.sample
!.env.template
appsettings.Local.json
appsettings.*.local.json
keystore.properties
*.jks
*.keystore
*.pfx
*.p12

# OS, editor, and runtime temporary files
.DS_Store
Thumbs.db
Desktop.ini
*.log
*.tmp
*.temp
*.swp
*.swo
*~
